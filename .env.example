# ============================================
# VoIP Platform — Environment Configuration
# ============================================

# --- App ---
NODE_ENV=development
APP_NAME=SecureVoIP
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=voip_user
DATABASE_PASSWORD=voip_secure_pass
DATABASE_NAME=voip_platform
DATABASE_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption ---
ENCRYPTION_KEY=32_char_aes256_key_change_this!!

# --- VoIP / SIP ---
SIP_DOMAIN=sip.yourdomain.com
SIP_WS_URL=wss://sip.yourdomain.com:7443
FREESWITCH_HOST=localhost
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon
ASTERISK_HOST=localhost
ASTERISK_PORT=5038
ASTERISK_USER=admin
ASTERISK_PASSWORD=asterisk_pass

# --- Twilio (for SMS/Numbers) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WEBHOOK_URL=https://yourdomain.com/api/webhooks/twilio

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- PayPal ---
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# --- SendGrid (Email) ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@securevoip.com

# --- Firebase (Push Notifications) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# --- AWS S3 (Media Storage) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=voip-platform-media
AWS_REGION=us-east-1

# --- QR Auth ---
QR_CODE_SECRET=qr_auth_secret_key
QR_CODE_EXPIRY=300

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Monitoring ---
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
